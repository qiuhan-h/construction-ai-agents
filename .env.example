# =====================================================
# construction-ai-agents 环境变量模板
# 复制为 .env 后填写实际值（.env 已被 .gitignore 忽略，不会入库）
# 在每行 `# >>>` 下面的注释处填写真实值
# =====================================================

# ---------- 应用 ----------
APP_ENV=dev
# >>> API 监听地址：dev 填 0.0.0.0，prod 填内网 IP 如 192.168.1.100
API_HOST=
# >>> API 监听端口：默认 8000，如需改端口填数字如 8001
API_PORT=8000
# >>> 日志级别：DEBUG / INFO / WARNING / ERROR，prod 建议 INFO
LOG_LEVEL=INFO

# ---------- 数据库 (PostgreSQL) ----------
# >>> PostgreSQL 连接串：postgresql+psycopg://<用户名>:<密码>@<IP>:<端口>/<库名>
# >>> 示例：postgresql+psycopg://caai_app:MyPwd123@192.168.1.10:5432/construction_agents
# >>> 密码含 @ : / 等特殊字符需 URL 编码（@→%40 :→%3A /→%2F）
# >>> docker-compose 内部地址用 postgres 代替 IP：postgresql+psycopg://caai_app:MyPwd123@postgres:5432/construction_agents
DATABASE_URL=

# ---------- Redis ----------
# >>> Redis 地址：redis://[:<密码>@]<IP>:<端口>/<db>
# >>> 无密码示例：redis://192.168.1.20:6379/0
# >>> 有密码示例：redis://:MyPwd123@192.168.1.20:6379/0
# >>> docker-compose 内部地址：redis://redis:6379/0
REDIS_URL=
# >>> Celery Broker（建议 db 1）：redis://:MyPwd123@192.168.1.20:6379/1
# >>> docker-compose 内部：redis://redis:6379/1
CELERY_BROKER_URL=
# >>> Celery 结果后端（建议 db 2）：redis://:MyPwd123@192.168.1.20:6379/2
# >>> docker-compose 内部：redis://redis:6379/2
CELERY_RESULT_BACKEND=

# ---------- 时序库 (InfluxDB 2.x, 传感器高频数据) ----------
# >>> InfluxDB HTTP 地址：http://<IP>:<端口> 或 https://<IP>:<端口>
# >>> 示例：http://192.168.1.30:8086
# >>> docker-compose 内部：http://influxdb:8086
TSDB_URL=
# >>> InfluxDB API Token：需含读写目标 bucket 的权限
# >>> 示例：aBcDeFgHiJkLmN1234567890_abCdEfGhIjKlMnO-Pq==
# >>> docker-compose 中与 DOCKER_INFLUXDB_INIT_ADMIN_TOKEN 保持一致
TSDB_TOKEN=
# >>> InfluxDB 组织名：创建时确定，示例 construction
TSDB_ORG=
# >>> InfluxDB 桶名：建议按环境分桶，dev 用 sensor_data_dev，prod 用 sensor_data_prod
TSDB_BUCKET=

# ---------- LLM (OpenAI 兼容接口) ----------
# >>> LLM API Key：以下任选一家的密钥
# >>> 通义千问：sk-a1b2c3d4e5f6...
# >>> OpenAI：sk-proj-aBcD...
# >>> DeepSeek：sk-deep-a1b2c3...
# >>> 智谱 AI：aBcD1234.abCd5678...
# >>> Ollama 本地：ollama（任意非空）
# >>> vLLM 自建：vllm-local-token
LLM_API_KEY=
# >>> OpenAI 兼容服务基址（不含 /chat/completions）：
# >>> 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# >>> OpenAI：https://api.openai.com/v1
# >>> DeepSeek：https://api.deepseek.com/v1
# >>> 智谱 AI：https://open.bigmodel.cn/api/paas/v4
# >>> Ollama 本地：http://127.0.0.1:11434/v1
# >>> vLLM 自建：http://192.168.1.50:8000/v1
LLM_BASE_URL=
# >>> 默认模型名：
# >>> 通义千问：qwen-plus
# >>> OpenAI：gpt-4o-mini
# >>> DeepSeek：deepseek-chat
# >>> 智谱 AI：glm-4-flash
# >>> Ollama：qwen2.5:7b
# >>> vLLM：Qwen2.5-14B-Instruct
LLM_DEFAULT_MODEL=
# >>> LLM 提供方（关键！填了 KEY 不设此项仍走 mock 假回复）：
# >>>   mock      本地假回复，不产生真实调用/费用（默认，开发测试用）
# >>>   openai    OpenAI 兼容接口（通义千问/DeepSeek/智谱/Ollama/vLLM 都选此项）
# >>>   anthropic Anthropic 原生接口
# >>>   vllm      vLLM 自建（同 OpenAI 兼容）
LLM_PROVIDER=mock
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---------- 认证 ----------
# >>> JWT HS256 签名密钥：32 字节以上随机串
# >>> 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# >>> 生成示例：Vt8KpL2xNmQjR5sT9wYb3cD6eF1gH4aZ7iU0oX2cV8mB5nL3qP1rS4tW7yZ0
API_JWT_SECRET=

# ---------- 通知渠道（阶段六 6c 将实现自动读取，当前通过代码构造函数注入） ----------
# >>> 钉钉机器人 Webhook URL：https://oapi.dingtalk.com/robot/send?access_token=xxx
# >>> 获取方式：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
DINGTALK_WEBHOOK=
# >>> 钉钉加签密钥（可选）：以 SEC 开头的字符串
DINGTALK_SECRET=
# >>> 企微机器人 Webhook URL：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# >>> 获取方式：企业微信群 → 群设置 → 添加群机器人
WECOM_WEBHOOK=
# >>> 阿里云短信 AccessKey ID：以 LTAI 开头
# >>> 获取方式：阿里云控制台 → RAM → AccessKey 管理
ALIYUN_SMS_ACCESS_KEY_ID=
# >>> 阿里云短信 AccessKey Secret：30 位
ALIYUN_SMS_ACCESS_KEY_SECRET=
# >>> 阿里云短信签名：需在控制台审核通过
ALIYUN_SMS_SIGN_NAME=
# >>> 阿里云短信模板 ID：以 SMS_ 开头
ALIYUN_SMS_TEMPLATE_CODE=
# >>> 阿里云短信接收手机号：11 位
ALIYUN_SMS_PHONE=
# >>> 腾讯云短信 SecretId：以 AKID 开头
TENCENT_SMS_SECRET_ID=
# >>> 腾讯云短信 SecretKey：32 位
TENCENT_SMS_SECRET_KEY=
# >>> 腾讯云短信应用 ID：以 1400 开头
TENCENT_SMS_APP_ID=
# >>> 腾讯云短信签名
TENCENT_SMS_SIGN_NAME=
# >>> 腾讯云短信模板 ID：纯数字
TENCENT_SMS_TEMPLATE_ID=
# >>> 腾讯云短信接收手机号：11 位
TENCENT_SMS_PHONE=

# ---------- 可观测性（可选，不填则降级 NoOp） ----------
# >>> 是否启用 OpenTelemetry：1 启用，不填则不启用
ENABLE_OTEL=
# >>> OTLP 接收端地址：gRPC 用 http://otel-collector:4317，HTTP 用 http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# >>> 服务名：caai-api / caai-worker / caai-streamlit
OTEL_SERVICE_NAME=

# ---------- SM2 国密证书（可选，不填则降级 HMAC-SHA256） ----------
# 代码实际读取 SM2_CERT_DIR / SM2_PRIVATE_KEY / SM2_PUBLIC_KEY（见 core/security/cert_manager.py）
# >>> SM2 证书目录：每租户一个 {tenant_id}.json（内容 {"private_key": "...", "public_key": "..."}），默认 .certs
SM2_CERT_DIR=
# >>> SM2 私钥 PEM 内容（全局注入，与证书文件二选一；.env 中用 \n 表示换行，或优先用 K8s Secret 挂载文件）
SM2_PRIVATE_KEY=
# >>> SM2 公钥 PEM 内容（全局注入，与证书文件二选一）
SM2_PUBLIC_KEY=

# ---------- BIM (Autodesk Platform Services / Forge BIM360) ----------
# >>> APS 应用 Client ID：Autodesk Developer 后台创建应用获取
APS_CLIENT_ID=
# >>> APS 应用 Client Secret
APS_CLIENT_SECRET=
# >>> APS Hub ID：Autodesk BIM360 管理后台获取
APS_HUB_ID=
# >>> APS Project ID：BIM360 项目 ID
APS_PROJECT_ID=

# ---------- IoT (MQTT 传感器数据接入) ----------
# >>> MQTT Broker 地址：IP 或域名，如 192.168.1.40 或 mqtt.example.com
# >>> docker-compose 内部：mqtt-broker
MQTT_BROKER=
# >>> MQTT Broker 端口：默认 1883，TLS 加密用 8883
MQTT_PORT=

# ---------- 内嵌应用（钉钉 ISV / 企微自建应用，移动端免登+工作通知） ----------
# >>> 钉钉企业 CorpId：钉钉管理后台 → 企业信息
DINGTALK_CORP_ID=
# >>> 钉钉应用 AppKey：钉钉开发者后台创建应用获取
DINGTALK_APP_KEY=
# >>> 钉钉应用 AppSecret
DINGTALK_APP_SECRET=
# >>> 钉钉应用 AgentId
DINGTALK_AGENT_ID=
# >>> 企微企业 CorpID：企微管理后台 → 我的企业
WECOM_CORP_ID=
# >>> 企微自建应用 Secret
WECOM_SECRET=
# >>> 企微自建应用 AgentId（数字）
WECOM_AGENT_ID=

# ---------- 后端选择（可选，不填走内存降级） ----------
# >>> 向量存储后端：chroma / memory；不填走内存降级
VECTOR_STORE_BACKEND=
# >>> 电子围栏历史后端：sql / memory；生产建议 sql
GEOFENCE_HISTORY_BACKEND=

# ---------- Streamlit 上游 API ----------
# >>> Streamlit 访问 API 的地址：如 http://127.0.0.1:8000 或 http://api:8000
API_BASE_URL=
# >>> Streamlit 调 API 的服务 token
API_AUTH_TOKEN=

# ---------- Prometheus 指标（可选） ----------
# >>> 是否启用 Prometheus 指标：1 启用，不填则不启用
ENABLE_METRICS=

# ---------- CORS 白名单（7a-5 安全加固） ----------
# >>> 逗号分隔的允许跨域域名，如 https://app.example.com,https://admin.example.com
# >>> 空字符串表示禁止跨域；"*" 表示允许全部（仅 dev 使用，生产禁用 *）
CORS_ORIGINS=

# ---------- A2A / MCP 独立服务监听（scripts/start_*.py 使用，可选） ----------
# >>> A2A 服务监听地址/端口（默认 0.0.0.0:9101），Docker 内无需修改
A2A_HOST=
A2A_PORT=9101
# >>> MCP 服务监听地址/端口（默认 0.0.0.0:9201）
MCP_HOST=
MCP_PORT=9201
