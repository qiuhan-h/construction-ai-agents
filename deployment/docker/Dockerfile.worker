# ---- builder ----
FROM python:3.12-slim AS builder
WORKDIR /build
COPY requirements.txt pyproject.toml ./
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# ---- runtime ----
FROM python:3.12-slim
RUN useradd -u 1000 -m caai
WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
    -r requirements.txt && rm -rf /wheels
COPY --chown=caai:caai . /app
USER caai
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD celery -A services.celery_app inspect ping -d celery@${HOSTNAME:-worker} || exit 1
CMD ["celery", "-A", "services.celery_app", "worker", "--loglevel=info"]
